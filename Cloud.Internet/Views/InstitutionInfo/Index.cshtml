@model SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Models.View.InstitutionInfoDisplayModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("InstitutionInfo", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        dl {
            margin-bottom: 0;
        }

        #aboutus:last-child, #history:last-child {
            margin-bottom: 0 !important;
        }
    </style>
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <a class="btn btn-light float-right" asp-action="edit"><span class="fas fa-edit"></span> Editar</a>
        <h4 style="margin-bottom: 15px;">@ViewData["Title"].ToString()</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#aboutus" id="aboutus-tab" data-toggle="tab" role="tab" aria-controls="aboutus" aria-selected="true">Quienes Somos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#history" id="history-tab" data-toggle="tab" role="tab" aria-controls="history" aria-selected="true">Historia</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#contacts" id="contacts-tab" data-toggle="tab" role="tab" aria-controls="contacts" aria-selected="true">Datos de Contacto</a>
            </li>
        </ul>
    </div>
    <div class="card-body tab-content">
        <div class="tab-pane fade show active" id="aboutus" role="tabpanel" aria-labelledby="aboutus-tab">
            @Html.Raw(Model.AboutUs)
        </div>
        <div class="tab-pane fade" id="history" role="tabpanel" aria-labelledby="history-tab">
            @Html.Raw(Model.History)
        </div>
        <div class="tab-pane fade" id="contacts" role="tabpanel" aria-labelledby="contacts-tab">
            <div class="row">
                <dl class="col-sm-6">
                    <dt>@GlobalViewLocalizationHelper.Localize("Phone", ViewLocalizer)</dt>
                    <dd>@Model.ContactPhoneNumber</dd>
                </dl>
                <dl class="col-sm-6">
                    <dt>@GlobalViewLocalizationHelper.Localize("Email", ViewLocalizer)</dt>
                    <dd>@Model.ContactEmailAddress</dd>
                </dl>
            </div>
            <dl>
                <dt>@GlobalViewLocalizationHelper.Localize("PostalAddress", ViewLocalizer)</dt>
                <dd>@Model.ContactPostalAddress</dd>
            </dl>
            <fieldset>
                <legend>Localización</legend>
                <div class="row">
                    <dl class="col-sm-6">
                        <dt>@GlobalViewLocalizationHelper.Localize("Longitude", ViewLocalizer)</dt>
                        <dd class="mb-sm-1 mb-md-0">@Model.ContactMapLongitude</dd>
                    </dl>
                    <dl class="col-sm-6">
                        <dt>@GlobalViewLocalizationHelper.Localize("Latitude", ViewLocalizer)</dt>
                        <dd style="margin-bottom: 0;">@Model.ContactMapLatitude</dd>
                    </dl>
                </div>
            </fieldset>
        </div>
    </div>
</div>