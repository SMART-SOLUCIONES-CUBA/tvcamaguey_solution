@model SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Models.View.InstitutionInfoInputModel

@{
    ViewData["Title"] = "Modificar " + GlobalViewLocalizationHelper.Localize("InstitutionInfo", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = GlobalViewLocalizationHelper.Localize("institutioninfo", ViewLocalizer),
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section scripts {
    <script type="text/javascript" src="~/lib/tinymce/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '.rich-textarea',
            branding: false
        });
    </script>
}

@using (Html.BeginForm("edit", "institutioninfo", new { Area = string.Empty, key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4 style="margin-bottom: 15px;">@ViewData["Title"].ToString()</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#aboutus" id="aboutus-tab" data-toggle="tab" role="tab" aria-controls="aboutus" aria-selected="true">Quienes Somos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#history" id="history-tab" data-toggle="tab" role="tab" aria-controls="history" aria-selected="true">Historia</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contacts" id="contacts-tab" data-toggle="tab" role="tab" aria-controls="contacts" aria-selected="true">Datos de Contacto</a>
                </li>
            </ul>
        </div>
        <div class="card-body tab-content">
            <div class="tab-pane fade show active" id="aboutus" role="tabpanel" aria-labelledby="aboutus-tab">
                @Html.TextAreaFor(model => model.AboutUs, 10, 0, new { @class = "form-control rich-textarea" })
                @Html.ValidationMessageFor(model => model.AboutUs, null, new { @class = "text-danger" })
            </div>
            <div class="tab-pane fade" id="history" role="tabpanel" aria-labelledby="history-tab">
                @Html.TextAreaFor(model => model.History, 10, 0, new { @class = "form-control rich-textarea" })
                @Html.ValidationMessageFor(model => model.History, null, new { @class = "text-danger" })
            </div>
            <div class="tab-pane fade" id="contacts" role="tabpanel" aria-labelledby="contacts-tab">
                <div class="row">
                    <div class="col-md-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.ContactPhoneNumber, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.ContactPhoneNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ContactPhoneNumber, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6" style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.ContactEmailAddress, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.ContactEmailAddress, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ContactEmailAddress, null, new { @class = "text-danger" })
                    </div>
                </div>
                <div style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.ContactPostalAddress, new { @class = "control-label" })
                    @Html.TextAreaFor(model => model.ContactPostalAddress, 4, 0, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ContactPostalAddress, null, new { @class = "text-danger" })
                </div>

                <fieldset>
                    <legend>Localización</legend>
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.ContactMapLongitude, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.ContactMapLongitude, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ContactMapLongitude, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6" style="margin-bottom: 20px;">
                            @Html.LabelFor(model => model.ContactMapLatitude, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.ContactMapLatitude, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ContactMapLatitude, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" asp-action="index">Regresar</a>
        </div>
    </div>
}