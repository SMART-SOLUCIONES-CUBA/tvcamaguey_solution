@model SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Models.Filter.BillboardFilterModel

@using (Html.BeginForm("billboard", "presentations", new { Area = "business" }, FormMethod.Post, true, null))
{
    <fieldset>
        <legend>Filtro de Cartelera</legend>
        <div class="row">
            <div class="col-md-6" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.StartDate, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.StartDate, new { @class = "form-control", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.StartDate, null, new { @class = "text-danger" })
            </div>
            <div class="col-md-6" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.EndDate, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.EndDate, new { @class = "form-control", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.EndDate, null, new { @class = "text-danger" })
            </div>
        </div>

        <div>
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-filter"></span> Filtrar</button>
        </div>
    </fieldset>
}
