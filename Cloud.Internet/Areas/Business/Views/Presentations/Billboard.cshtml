@model SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Models.View.BillboardViewModel

@{
    ViewData["Title"] = "Presentaciones";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = string.Empty, key = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/gijgo/modular/css/core.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/gijgo/modular/css/datepicker.min.css" type="text/css" />

    <style type="text/css">
        .show-overview-container {
            display: inline-block;
            margin-right: 20px;
            vertical-align: top;
        }
    </style>
}

@section scripts {
    <script src="~/lib/gijgo/modular/js/core.min.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/modular/js/datepicker.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        $('#StartDate').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            locale: 'es-es',
            format: 'dd/mm/yyyy',
            value: '@Model.Filter.StartDate.ToShortDateString()'
        });
        $('#EndDate').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            locale: 'es-es',
            format: 'dd/mm/yyyy',
            value: '@Model.Filter.EndDate.ToShortDateString()'
        });
    </script>
}

<div class="row" style="margin-bottom: 20px;">
    <div class="col-sm-4"></div>
    <div class="col-sm-4" style="text-align: center;">
        <div class="btn-group">
            <button class="btn btn-primary" style="cursor:default;"><span class="fas fa-calendar"></span> Cartelera</button>
            <a class="btn btn-light" href="@Url.Action("index")"><span class="fas fa-list-alt"></span> Listado</a>
        </div>
    </div>
    <div class="col-sm-4" style="text-align: right;"></div>
</div>

@await Html.PartialAsync("_BillboardFilterPartial", Model.Filter)

<hr />

@if (Model.DailyBillboards.Count > 0)
{
    foreach (var item in Model.DailyBillboards)
    {
        <div class="card" style="margin-bottom: 20px;">
            <div class="card-header">@item.At.ToLongDateString()</div>
            <div class="card-body" style="overflow-x: scroll; overflow-y: hidden; white-space: nowrap;">
                @if (item.Presentations.Count > 0)
                {
                    @foreach (var presentation in item.Presentations)
                    {
                        <div class="show-overview-container">
                            <div style="text-align: center; font-weight: bold; font-size: 20px;">
                                <span>@presentation.At.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </div>
                            <img class="img-thumbnail" style="width: 200px;" src="~/media/images/@presentation.ShowLogoId.@presentation.ShowLogoExtension" />
                            <div style="width: 200px; text-align: center; margin-top: 10px;">
                                <span style="white-space: pre-wrap;">@presentation.ShowName</span>
                            </div>
                        </div>
                    }
                    <div class="clearfix"></div>
                }
                else
                {
                    <p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p>
                }
            </div>
        </div>
    }
}
else
{
    <p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p>
}