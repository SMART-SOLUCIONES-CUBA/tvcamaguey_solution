@model SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Models.View.CategoryDisplayViewModel

@{
    ViewData["Title"] = "Eliminar " + GlobalViewLocalizationHelper.Localize("Category", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = GlobalViewLocalizationHelper.Localize("Categories", ViewLocalizer),
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar la categoría detallada a continuación?</h3>

<dl>
    <dt>@GlobalViewLocalizationHelper.Localize("Name", ViewLocalizer)</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>
    <dt>@GlobalViewLocalizationHelper.Localize("Parent", ViewLocalizer)</dt>
    <dd>@if (string.IsNullOrEmpty(Model.ParentName)) { <span>-</span> } else { <span>@Html.DisplayFor(model => model.ParentName)</span> }</dd>
</dl>
@using (Html.BeginForm("delete", "categories", new { Area = "communication", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}

