<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:jmci="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:providers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Providers"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Rendered"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.MasterPage"
    Title="Navegación"
    x:Name="Page">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <converters:UserImageIdToOverviewImageSourceConverter x:Key="UserImageIdToOverviewImageSource" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.IconImageSource>
        <FontImageSource
            Glyph="&#xf35c;">
            <FontImageSource.Color>
                <OnPlatform x:TypeArguments="Color">
                    <On Platform="UWP" Value="Black" />
                </OnPlatform>
            </FontImageSource.Color>
            <FontImageSource.FontFamily>
                <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                    <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                </OnPlatform>
            </FontImageSource.FontFamily>
        </FontImageSource>
    </ContentPage.IconImageSource>
    <ContentPage.Content>
        <Grid
            RowSpacing="0" ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ListView
                x:Name="NavigationListView"
                Grid.RowSpan="2"
                BackgroundColor="GhostWhite"
                Header="{Binding .}"
                IsGroupingEnabled="True"
                GroupDisplayBinding="{Binding Title}"
                ItemsSource="{Binding NavigationSectionGroups}"
                ItemSelected="NavigationListView_ItemSelected">
                <ListView.GroupHeaderTemplate>
                    <DataTemplate>
                        <ViewCell ios:Cell.DefaultBackgroundColor="GhostWhite">
                            <Label
                                Margin="10"
                                Text="{Binding Path=Title}"
                                TextColor="DimGray" />
                        </ViewCell>
                    </DataTemplate>
                </ListView.GroupHeaderTemplate>
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid
                            Grid.Row="0"
                            BackgroundColor="{StaticResource BrandPrimaryColor}"
                            HeightRequest="{Binding Source={x:Reference Page}, Path=Width, Converter={StaticResource Fraction}, ConverterParameter=1.5, Mode=OneWay}">
                            <Image
                                Opacity="0.20"
                                Aspect="AspectFill"
                                Source="{Binding Source={x:Static providers:ImageSourceProvider.Instance}, Path=RandomRegionImageSource}" />
                            <Grid Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0" VerticalOptions="Center">
                                    <jmci:CircleImage
                                        HorizontalOptions="Center"
                                        BorderThickness="2"
                                        BorderColor="WhiteSmoke"
                                        Source="{Binding ProfileImageId, Converter={StaticResource UserImageIdToOverviewImageSource}, ConverterParameter={x:Reference Page}}"
                                        HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}"
                                        WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                </StackLayout>
                                <StackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label 
                                        Text="{Binding Path=SessionName}" 
                                        TextColor="White"
                                        FontSize="18"
                                        VerticalTextAlignment="End" />
                                    <Label 
                                        Text="{Binding Path=SessionLogin}" 
                                        TextColor="WhiteSmoke"
                                        LineBreakMode="TailTruncation"
                                        FontSize="15" />
                                </StackLayout>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <OnPlatform x:TypeArguments="DataTemplate">
                        <On Platform="UWP">
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Orientation="Horizontal" Margin="10">
                                        <Label 
                                            Text="{Binding Glyph}" 
                                            TextColor="Black"
                                            VerticalOptions="CenterAndExpand"
                                            FontSize="Medium"
                                            FontFamily="{Binding FontFamily}"
                                            Margin="0,0,4,0" />
                                        <Label 
                                            Text="{Binding Title}" 
                                            TextColor="Black"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </On>
                        <On Platform="Android,iOS">
                            <DataTemplate>
                                <renderedviews:ResponsiveImageCell 
                                    Text="{Binding Title}"
                                    TextColor="Black">
                                    <ImageCell.ImageSource>
                                        <FontImageSource 
                                            Glyph="{Binding Glyph}"
                                            FontFamily="{Binding FontFamily}"
                                            Color="Black" />
                                    </ImageCell.ImageSource>
                                </renderedviews:ResponsiveImageCell>
                            </DataTemplate>
                        </On>
                    </OnPlatform>                    
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Grid>
                        <Image
                            Margin="0,80,0,0"
                            VerticalOptions="End" HorizontalOptions="Start">
                            <Image.Source>
                                <OnPlatform x:TypeArguments="FileImageSource">
                                    <On Platform="Android" Value="vendor_tail.png" />
                                    <On Platform="UWP" Value="Assets/Images/VendorTail.png" />
                                    <On Platform="iOS" Value="VendorTail" />
                                </OnPlatform>
                            </Image.Source>
                        </Image>
                        <StackLayout Spacing="0" Margin="10,40,10,80">
                            <Label 
                                FontSize="Small"
                                HorizontalTextAlignment="Center"
                                Text="Televisión Camagüey"
                                TextColor="Black" />
                            <Label 
                                FontSize="Micro" 
                                HorizontalTextAlignment="Center"
                                Text="SMART SOLUCIONES CUBA (SSC)"
                                TextColor="DimGray" />
                            <Label 
                                FontSize="Micro" 
                                HorizontalTextAlignment="Center"
                                Text="2020"
                                TextColor="Gray" />
                        </StackLayout>
                    </Grid>
                </ListView.Footer>
            </ListView>            
            <sscxftoolkitpresentationviews:BusyView 
                Grid.RowSpan="2" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>