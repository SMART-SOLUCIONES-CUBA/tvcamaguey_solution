<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:viewmodels="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Models.View"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Rendered"
    xmlns:selectors="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Cell.Selector"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.BillboardPage"
    Title="Cartelera">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ImageEntityToImageSourceConverter x:Key="ImageEntityToImageSource" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="Factor" />

            <DataTemplate x:Key="FullPresentationTemplate">
                <x:Arguments>
                    <Type  TypeName="viewmodels:FullPresentationViewModel" />
                </x:Arguments>
                <ViewCell>
                    <Grid HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewRowHeight}">
                        <ffimageloadingforms:CachedImage
                            Opacity="0.08"
                            Aspect="AspectFill"
                            Source="{Binding Path=Presentation.Show.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                        <Grid
                            ColumnSpacing="0" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ffimageloadingforms:CachedImage
                                Grid.Column="0"
                                WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewRowHeight, Converter={StaticResource Factor}, ConverterParameter=1.777777777777778}"
                                Source="{Binding Path=Presentation.Show.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                        </Grid>
                        <Grid
                            Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Column="0" Grid.Row="0"
                                Padding="8"
                                BackgroundColor="{StaticResource BrandPrimaryOpaqueColor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <renderedviews:FontStrechLabel
                                    Grid.Column="0" Grid.RowSpan="2"
                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtHourFontSize}"
                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                    Text="{Binding Path=Presentation.At, StringFormat='{0:hh}'}"
                                    TextColor="White">
                                    <Label.Margin>
                                        <OnPlatform Android="0,1,0,0" UWP="0,2,0,0" />
                                    </Label.Margin>
                                </renderedviews:FontStrechLabel>
                                <Label
                                    Grid.Column="1" Grid.Row="0"
                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                    FontAttributes="Bold"
                                    Text="{Binding Path=Presentation.At, StringFormat='{0:mm}'}"
                                    TextColor="White"
                                    VerticalOptions="End" />
                                <Label
                                    Grid.Column="1" Grid.Row="1"
                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                    FontAttributes="Bold"
                                    Text="{Binding Path=Presentation.At, StringFormat='{0:tt}'}"
                                    TextColor="White"
                                    VerticalOptions="Start" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ViewCell>
            </DataTemplate>

            <DataTemplate x:Key="NullPresentationTemplate">
                <x:Arguments>
                    <Type TypeName="viewmodels:EmptyPresentationViewModel" />
                </x:Arguments>
                <ViewCell>
                    <StackLayout>
                        <Label
                            Margin="20"
                            Text="Sin elementos que mostrar"
                            TextColor="Black" />
                    </StackLayout>
                </ViewCell>
            </DataTemplate>

            <selectors:PresentationDataTemplateSelector 
                x:Key="PresentationDataTemplate" 
                DefaultDataTemplate="{StaticResource FullPresentationTemplate}" 
                NullDataTemplate="{StaticResource NullPresentationTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Anteriores"
            Clicked="BeforesToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xf150;">
                    <FontImageSource.Color>
                        <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="UpdateToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <ListView
            ItemsSource="{Binding DayPresentations}"
            ItemTemplate="{StaticResource PresentationDataTemplate}"
            CachingStrategy="RecycleElementAndDataTemplate"
            HasUnevenRows="True"
            IsGroupingEnabled="True"
            IsRefreshing="{Binding IsBusy}"
            IsPullToRefreshEnabled="True"
            Refreshing="ListView_Refreshing">
            <ListView.GroupHeaderTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Label
                            Text="{Binding Date, StringFormat='{0:MMMM dd, dddd}'}"
                            TextColor="DimGray"
                            FontSize="14"
                            Margin="20,30,20,10">
                        </Label>
                    </ViewCell>
                </DataTemplate>
            </ListView.GroupHeaderTemplate>
        </ListView>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>