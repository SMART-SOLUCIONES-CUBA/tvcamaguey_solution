<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:jmci="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.SessionProfileEditPage"
    x:Name="Page"
    ios:Page.UseSafeArea="True"
    Title="Modificar Perfil de Usuario">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="Factor" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <converters:UserImageIdToRegularImageSourceConverter x:Key="UserImageIdToRegularImageSource" />
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="16" />
            <converters:StringToLocalizeStringConverter x:Key="StringToLocalizeString" />

            <Style x:Key="FormGroup" TargetType="StackLayout">
                <Setter Property="Margin" Value="8,0,8,16" />
            </Style>
            <Style x:Key="FlexFormGroup" TargetType="StackLayout" BasedOn="{StaticResource FormGroup}">
                <Setter Property="WidthRequest" Value="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="Material Design Icons" 
                    Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="Material Design Icons" 
                    Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <StackLayout Spacing="0" Margin="8,0">                    
                    <Grid
                        Margin="0,48,0,40">
                        <jmci:CircleImage
                            x:Name="ProfileImage"
                            HorizontalOptions="Center"
                            BorderThickness="2"
                            BorderColor="{StaticResource BrandPrimaryColor}"
                            HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize}"
                            WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize}"
                            Source="{Binding ProfileImageId, Converter={StaticResource UserImageIdToRegularImageSource}, ConverterParameter={x:Reference Page}}" />
                        <Button
                            HorizontalOptions="Center"
                            BackgroundColor="#33000000"                           
                            HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize}"
                            WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize}"
                            BorderRadius="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize, Converter={StaticResource Fraction}, ConverterParameter=2}"
                            FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=RegularProfileImageSize, Converter={StaticResource Fraction}, ConverterParameter=3}"
                            FontFamily="Material Design Icons"
                            Text="&#xf100;"
                            TextColor="White"
                            Clicked="PickImageButton_Clicked" />
                    </Grid>
                    <FlexLayout
                        x:Name="ResponsiveWrapper"
                        Wrap="Wrap">
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label 
                                Style="{StaticResource FormLabel}"
                                Text="Nombre(s)" />
                            <Entry Text="{Binding Name}" />
                        </StackLayout>
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label  
                                Style="{StaticResource FormLabel}"
                                Text="Apellidos" />
                            <Entry Text="{Binding LastName}" />
                        </StackLayout>
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label 
                                Style="{StaticResource FormLabel}"
                                Text="Fecha de Nacimiento" />
                            <DatePicker Date="{Binding BornDate}" />
                        </StackLayout>
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label  
                                Style="{StaticResource FormLabel}"
                                Text="Alias" />
                            <Entry Text="{Binding Alias}" />
                        </StackLayout>
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label 
                                Style="{StaticResource FormLabel}"
                                Text="Sexo" />
                            <Picker 
                                ItemsSource="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=Sex_All}"
                                ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeString}}"
                                SelectedItem="{Binding Sex}" />
                        </StackLayout>
                        <StackLayout Style="{StaticResource FlexFormGroup}">
                            <Label  
                                Style="{StaticResource FormLabel}"
                                Text="Estado Civil" />
                            <Picker 
                                ItemsSource="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=CivilStatus_All}"
                                ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeString}}"
                                SelectedItem="{Binding CivilStatus}" />
                        </StackLayout>
                    </FlexLayout>
                    <StackLayout Style="{StaticResource FormGroup}">
                        <Label  
                            Style="{StaticResource FormLabel}"
                            Text="Acerca de" />
                        <Editor
                            Text="{Binding About}"
                            HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FormGroupRequestHeight, Converter={StaticResource Factor}, ConverterParameter=2}" />
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <sscxftoolkitpresentationviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>