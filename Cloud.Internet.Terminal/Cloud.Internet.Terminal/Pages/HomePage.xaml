<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:ffilforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:providers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Providers"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Rendered"
    xmlns:selectors="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Cell.Selector"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"    
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:pancake="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.HomePage"
    Title="Portada"
    x:Name="Page">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="UpdateToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                    <FontImageSource.FontFamily>
                        <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                            <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                        </OnPlatform>
                    </FontImageSource.FontFamily>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="HasPosterPostDataTemplate">
                <pancake:PancakeView 
                    BackgroundColor="White" 
                    Margin="8"
                    Padding="0"
                    WidthRequest="240" HeightRequest="360"
                    CornerRadius="4">
                    <pancake:PancakeView.Shadow>
                        <pancake:DropShadow>
                            <pancake:DropShadow.BlurRadius>
                                <OnPlatform x:TypeArguments="x:Single" Default="2">
                                    <On Platform="UWP" Value="6" />
                                </OnPlatform>
                            </pancake:DropShadow.BlurRadius>
                        </pancake:DropShadow>
                    </pancake:PancakeView.Shadow>
                    <pancake:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PostsItem_Tapped" />
                    </pancake:PancakeView.GestureRecognizers>
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <BoxView Color="Black" Grid.Row="0" />
                        <ffilforms:CachedImage
                            Grid.Row="0"
                            Aspect="AspectFill"
                            Source="{Binding Path=Post.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                        <StackLayout 
                            Grid.Row="1"
                            Margin="8" Spacing="8">
                            <Label 
                                VerticalOptions="StartAndExpand"
                                Text="{Binding Path=Post.Title}"
                                TextColor="Black"
                                FontSize="Title"
                                MaxLines="4"
                                LineBreakMode="TailTruncation">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Condensed">
                                        <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Cond.otf#Helvetica LT Std" />
                                    </OnPlatform>
                                </Label.FontFamily>
                                <Label.Padding>
                                    <OnPlatform x:TypeArguments="Thickness" Default="0">
                                        <On Platform="iOS" Value="0,4,0,0" />
                                    </OnPlatform>
                                </Label.Padding>
                            </Label>
                            <Label 
                                Text="{Binding Path=Post.PostedAt, Converter={StaticResource DateTimeToInvarianCultureRelativeDateTimeString}}"
                                TextColor="DarkGray">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                        <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                        </StackLayout>
                    </Grid>
                </pancake:PancakeView>
            </DataTemplate>
            <DataTemplate x:Key="TextOnlyPostDataTemplate">
                <pancake:PancakeView 
                    BackgroundColor="White"
                    Margin="8"
                    Padding="0"
                    WidthRequest="240" HeightRequest="360"
                    CornerRadius="4">
                    <pancake:PancakeView.Shadow>
                        <pancake:DropShadow>
                            <pancake:DropShadow.BlurRadius>
                                <OnPlatform x:TypeArguments="x:Single" Default="2">
                                    <On Platform="UWP" Value="6" />
                                </OnPlatform>
                            </pancake:DropShadow.BlurRadius>
                        </pancake:DropShadow>
                    </pancake:PancakeView.Shadow>
                    <pancake:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PostsItem_Tapped" />
                    </pancake:PancakeView.GestureRecognizers>
                    <StackLayout 
                            Grid.Row="1"
                            Margin="8" Spacing="8">
                        <Label 
                            Text="{Binding Path=Post.Title}"
                            TextColor="Black"
                            FontSize="Title"
                            MaxLines="5"
                            LineBreakMode="TailTruncation">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Condensed">
                                    <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Cond.otf#Helvetica LT Std" />
                                </OnPlatform>
                            </Label.FontFamily>
                            <Label.Padding>
                                <OnPlatform x:TypeArguments="Thickness" Default="0">
                                    <On Platform="iOS" Value="0,4,0,0" />
                                </OnPlatform>
                            </Label.Padding>
                        </Label>
                        <Label 
                            VerticalOptions="StartAndExpand"
                            Text="{Binding Path=Post.Summary}"
                            TextColor="Black"
                            MaxLines="7"
                            LineBreakMode="TailTruncation">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Light">
                                    <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Light.otf#Helvetica LT Std" />
                                </OnPlatform>
                            </Label.FontFamily>
                            <Label.Padding>
                                <OnPlatform x:TypeArguments="Thickness">
                                    <On Platform="iOS" Value="0,1,0,0" />
                                </OnPlatform>
                            </Label.Padding>
                        </Label>
                        <Label 
                            Text="{Binding Path=Post.PostedAt, Converter={StaticResource DateTimeToInvarianCultureRelativeDateTimeString}}"
                            TextColor="DarkGray">
                            <Label.FontFamily>
                                <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                    <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                </OnPlatform>
                            </Label.FontFamily>
                        </Label>
                    </StackLayout>
                </pancake:PancakeView>
            </DataTemplate>

            <selectors:PostCardDataTemplateSelector 
                x:Key="PostCardDataTemplateSelector"
                TextOnlyDataTemplate="{StaticResource TextOnlyPostDataTemplate}" 
                HasPosterDataTemplate="{StaticResource HasPosterPostDataTemplate}" />

            <converters:ImageEntityToImageSourceConverter x:Key="ImageEntityToImageSource" />
            <converters:DateTimeToInvarianCultureRelativeDateTimeStringConverter x:Key="DateTimeToInvarianCultureRelativeDateTimeString" />
            <converters:DateTimeToInvarianCultureRelativeDayStringConverter x:Key="DateTimeToInvarianCultureRelativeDayString" />
            <converters:HomePageWidthToHomeHeaderSectionWidthConverter x:Key="HomePageWidthToHomeHeaderSectionWidth" />
            <converters:HomePageWidthToHomeHeaderSectionHeightConverter x:Key="HomePageWidthToHomeHeaderSectionHeight" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="Factor" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBoolean" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBoolean" Inverse="True" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <RefreshView
            IsRefreshing="{Binding Path=IsBusy}"
            Refreshing="RefreshView_Refreshing">
            <ScrollView>
                <StackLayout Spacing="0" Padding="0,0,0,8">
                    <Grid
                        Margin="0,0,0,8"
                        BackgroundColor="{StaticResource BrandPrimaryColor}">
                        <Image
                            Opacity="0.20"
                            Aspect="AspectFill"
                            Source="{Binding Source={x:Static providers:ImageSourceProvider.Instance}, Path=RandomOfficeImageSource}" />
                        <StackLayout                        
                            Margin="10,50"
                            VerticalOptions="Center" HorizontalOptions="Center">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform x:TypeArguments="FileImageSource">
                                        <On Platform="Android" Value="app_logo.png" />
                                        <On Platform="UWP" Value="Assets/Images/AppLogo.png" />
                                        <On Platform="iOS" Value="AppLogoSmall" />
                                    </OnPlatform>
                                </Image.Source>
                            </Image>
                            <Label 
                                HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span 
                                            Text="TuTV" 
                                            TextColor="#c3c3c3"
                                            FontSize="Subtitle">
                                            <Span.FontFamily>
                                                <OnPlatform x:TypeArguments="x:String" Default="Souvenir Lt BT Bold">
                                                    <On Platform="UWP" Value="/Assets/Fonts/SOUVNRD.ttf#Souvenir Lt BT" />
                                                </OnPlatform>
                                            </Span.FontFamily>
                                        </Span>
                                        <Span 
                                            Text="Camagüey"
                                            TextColor="#f2f2f2"
                                            FontSize="Subtitle">
                                            <Span.FontFamily>
                                                <OnPlatform x:TypeArguments="x:String" Default="Souvenir Lt BT Bold">
                                                    <On Platform="UWP" Value="/Assets/Fonts/SOUVNRD.ttf#Souvenir Lt BT" />
                                                </OnPlatform>
                                            </Span.FontFamily>
                                        </Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Text="{StaticResource ProductConcept}"
                                TextColor="WhiteSmoke"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Bienvenido"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                FontSize="Title">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Souvenir Medium">
                                        <On Platform="UWP" Value="/Assets/Fonts/Souvenir-Medium.otf#ITC Souvenir" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                        </StackLayout>
                    </Grid>
                    <StackLayout Padding="8,8,8,0" Spacing="8">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Text="&#xfdfa;"
                                TextColor="Black"
                                VerticalTextAlignment="Center"
                                FontSize="Medium">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                        <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                            <Label 
                                Grid.Column="1" Grid.Row="0"
                                Text="Cartelera"
                                TextColor="Black"
                                VerticalTextAlignment="Center"
                                FontSize="Subtitle">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Souvenir Medium">
                                        <On Platform="UWP" Value="/Assets/Fonts/Souvenir-Medium.otf#ITC Souvenir" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                            <Button
                                Grid.Column="2" Grid.Row="0"
                                VerticalOptions="Center"
                                Text="Ver más"
                                TextColor="{StaticResource BrandSecoundaryColor}"
                                BackgroundColor="Transparent"
                                Clicked="ViewMoreBillboardButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="3" Grid.Row="1"
                                Color="DimGray" />
                        </Grid>
                    </StackLayout>
                    <StackLayout Spacing="0">
                        <ScrollView Orientation="Horizontal">
                            <FlexLayout
                                Padding="8"
                                BindableLayout.ItemsSource="{Binding Presentations}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <pancake:PancakeView 
                                            WidthRequest="320" HeightRequest="180"
                                            Padding="0"
                                            Margin="8"
                                            CornerRadius="4">
                                            <pancake:PancakeView.Shadow>
                                                <pancake:DropShadow>
                                                    <pancake:DropShadow.BlurRadius>
                                                        <OnPlatform x:TypeArguments="x:Single" Default="2">
                                                            <On Platform="UWP" Value="6" />
                                                        </OnPlatform>
                                                    </pancake:DropShadow.BlurRadius>
                                                </pancake:DropShadow>
                                            </pancake:PancakeView.Shadow>
                                            <pancake:PancakeView.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="PresentationsItem_Tapped" />
                                            </pancake:PancakeView.GestureRecognizers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <ffilforms:CachedImage
                                                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                                                    Aspect="AspectFill"
                                                    Source="{Binding Path=Show.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                                                <Grid
                                                    Grid.Column="0" Grid.Row="0"
                                                    Padding="8"
                                                    BackgroundColor="{StaticResource BrandPrimaryOpaqueColor}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Label
                                                        Grid.ColumnSpan="2" Grid.Row="0"
                                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                        Text="{Binding Path=At, Converter={StaticResource DateTimeToInvarianCultureRelativeDayString}}"
                                                        TextColor="White"
                                                        HorizontalTextAlignment="Center">
                                                        <Label.FontFamily>
                                                            <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                                                <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                                            </OnPlatform>
                                                        </Label.FontFamily>
                                                    </Label>
                                                    <renderedviews:FontStrechLabel
                                                        Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                                                        HeightRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtHourFontSize, Converter={StaticResource Factor}, ConverterParameter=0.8}"
                                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtHourFontSize}"
                                                        Text="{Binding Path=At, StringFormat='{0:hh}'}"
                                                        TextColor="White">
                                                        <Label.FontFamily>
                                                            <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                                                <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                                            </OnPlatform>
                                                        </Label.FontFamily>
                                                        <Label.Margin>
                                                            <OnPlatform x:TypeArguments="Thickness" Default="0">
                                                                <On Platform="Android" Value="0,4,0,0" />
                                                                <On Platform="UWP" Value="0,2,0,0" />
                                                            </OnPlatform>
                                                        </Label.Margin>
                                                        <Label.Padding>
                                                            <OnPlatform x:TypeArguments="Thickness" Default="0">
                                                                <On Platform="iOS" Value="0,14,0,0" />
                                                            </OnPlatform>
                                                        </Label.Padding>
                                                    </renderedviews:FontStrechLabel>
                                                    <Label
                                                        Grid.Column="1" Grid.Row="1"
                                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                        FontAttributes="Bold"
                                                        Text="{Binding Path=At, StringFormat='{0:mm}'}"
                                                        TextColor="White"
                                                        VerticalOptions="End">
                                                        <Label.FontFamily>
                                                            <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                                                <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                                            </OnPlatform>
                                                        </Label.FontFamily>
                                                    </Label>
                                                    <Label
                                                        Grid.Column="1" Grid.Row="2"
                                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                        FontAttributes="Bold"
                                                        Text="{Binding Path=At, StringFormat='{0:tt}'}"
                                                        TextColor="White"
                                                        VerticalOptions="Start">
                                                        <Label.FontFamily>
                                                            <OnPlatform x:TypeArguments="x:String" Default="Helvetica LT Std Compresed">
                                                                <On Platform="UWP" Value="/Assets/Fonts/HelveticaLTStd-Compressed.otf#Helvetica LT Std" />
                                                            </OnPlatform>
                                                        </Label.FontFamily>
                                                    </Label>
                                                </Grid>
                                            </Grid>
                                        </pancake:PancakeView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                        <ActivityIndicator IsRunning="True" IsVisible="{Binding Presentations, Converter={StaticResource NullToBoolean}}" />
                        <Label 
                            Margin="16,0,16,8"
                            IsVisible="{Binding Presentations, Converter={StaticResource EnumerableEmptyToBoolean}}"
                            Text="Sin elementos que mostrar"
                            TextColor="DimGray" />
                    </StackLayout>
                    <StackLayout Padding="8,8,8,0" Spacing="8">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Text="&#xf395;"
                                TextColor="Black"
                                VerticalTextAlignment="Center"
                                FontSize="Medium">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Material Design Icons">
                                        <On Platform="UWP" Value="/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                            <Label 
                                Grid.Column="1" Grid.Row="0"
                                Text="Noticias"
                                TextColor="Black"
                                VerticalTextAlignment="Center"
                                FontSize="Subtitle">
                                <Label.FontFamily>
                                    <OnPlatform x:TypeArguments="x:String" Default="Souvenir Medium">
                                        <On Platform="UWP" Value="/Assets/Fonts/Souvenir-Medium.otf#ITC Souvenir" />
                                    </OnPlatform>
                                </Label.FontFamily>
                            </Label>
                            <Button
                                Grid.Column="2" Grid.Row="0"
                                VerticalOptions="Center"
                                Text="Ver más"
                                TextColor="{StaticResource BrandSecoundaryColor}"
                                BackgroundColor="Transparent"
                                Clicked="ViewMoreNewsButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="3" Grid.Row="1"
                                Color="DimGray" />
                        </Grid>
                    </StackLayout>
                    <StackLayout Spacing="0">
                        <ScrollView Orientation="Horizontal">
                            <FlexLayout
                                Padding="8"
                                BindableLayout.ItemsSource="{Binding Posts}"
                                BindableLayout.ItemTemplateSelector="{StaticResource PostCardDataTemplateSelector}"/>
                        </ScrollView>
                        <ActivityIndicator IsRunning="True" IsVisible="{Binding Posts, Converter={StaticResource NullToBoolean}}" />
                        <Label 
                            Margin="16,0,16,8"
                            IsVisible="{Binding Posts, Converter={StaticResource EnumerableEmptyToBoolean}}"
                            Text="Sin elementos que mostrar"
                            TextColor="DimGray" />
                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </RefreshView>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>