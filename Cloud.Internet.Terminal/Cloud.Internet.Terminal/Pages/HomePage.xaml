<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:providers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Providers"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Rendered"
    xmlns:selectors="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Views.Cell.Selector"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationrenderedviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views.Rendered;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.HomePage"
    Title="Portada"
    x:Name="Page">
    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="HasPosterPostDataTemplate">
                <Frame 
                    BackgroundColor="White" 
                    Margin="8"
                    Padding="0"
                    WidthRequest="240" HeightRequest="360">
                    <Frame.GestureRecognizers>
                        <ClickGestureRecognizer Clicked="PostsItemClickGesture_Recognized" />
                    </Frame.GestureRecognizers>
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <BoxView Color="Black" Grid.Row="0" />
                        <ffimageloadingforms:CachedImage
                            Grid.Row="0"
                            Aspect="AspectFill"
                            Source="{Binding Path=Post.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                        <StackLayout 
                            Grid.Row="1"
                            Margin="8" Spacing="8">
                            <Label 
                                VerticalOptions="StartAndExpand"
                                Text="{Binding Path=Post.Title}"
                                TextColor="Black"
                                FontSize="Title"
                                FontFamily="{StaticResource HelveticaLTStdCondFontFamily}"
                                MaxLines="4"
                                LineBreakMode="TailTruncation" />
                            <Label 
                                Text="{Binding Path=Post.PostedAt, Converter={StaticResource DateTimeToInvarianCultureRelativeDateTimeString}}"
                                TextColor="DarkGray"
                                FontFamily="{StaticResource HelveticaLTStdCompFontFamily}" />
                        </StackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
            <DataTemplate x:Key="TextOnlyPostDataTemplate">
                <Frame 
                    BackgroundColor="White" 
                    Margin="8"
                    Padding="0"
                    WidthRequest="240" HeightRequest="360">
                    <Frame.GestureRecognizers>
                        <ClickGestureRecognizer Clicked="PostsItemClickGesture_Recognized" />
                    </Frame.GestureRecognizers>
                    <StackLayout 
                            Grid.Row="1"
                            Margin="8" Spacing="8">
                        <Label 
                            Text="{Binding Path=Post.Title}"
                            TextColor="Black"
                            FontSize="Title"
                            FontFamily="{StaticResource HelveticaLTStdCondFontFamily}"
                            MaxLines="5"
                            LineBreakMode="TailTruncation" />
                        <Label 
                            VerticalOptions="StartAndExpand"
                            Text="{Binding Path=Post.Summary}"
                            TextColor="Black"
                            FontFamily="{StaticResource HelveticaLTStdLightFontFamily}"
                            MaxLines="7"
                            LineBreakMode="TailTruncation" />
                        <Label 
                            Text="{Binding Path=Post.PostedAt, Converter={StaticResource DateTimeToInvarianCultureRelativeDateTimeString}}"
                            TextColor="DarkGray"
                            FontFamily="{StaticResource HelveticaLTStdCompFontFamily}" />
                    </StackLayout>
                </Frame>
            </DataTemplate>

            <selectors:PostCardDataTemplateSelector 
                x:Key="PostCardDataTemplateSelector"
                TextOnlyDataTemplate="{StaticResource TextOnlyPostDataTemplate}" 
                HasPosterDataTemplate="{StaticResource HasPosterPostDataTemplate}" />

            <converters:ImageEntityToImageSourceConverter x:Key="ImageEntityToImageSource" />
            <converters:DateTimeToInvarianCultureRelativeDateTimeStringConverter x:Key="DateTimeToInvarianCultureRelativeDateTimeString" />
            <converters:DateTimeToInvarianCultureRelativeDayStringConverter x:Key="DateTimeToInvarianCultureRelativeDayString" />
            <converters:HomePageWidthToHomeHeaderSectionWidthConverter x:Key="HomePageWidthToHomeHeaderSectionWidth" />
            <converters:HomePageWidthToHomeHeaderSectionHeightConverter x:Key="HomePageWidthToHomeHeaderSectionHeight" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="Fraction" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBoolean" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBoolean" Inverse="True" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="0,0,0,8" BackgroundColor="#30D3D3D3">
                <FlexLayout Wrap="Wrap">
                    <Grid
                        x:Name="AnimationVideoClipContainer"
                        WidthRequest="{Binding Source={x:Reference Page}, Path=Width, Converter={StaticResource HomePageWidthToHomeHeaderSectionWidth}}"
                        HeightRequest="{Binding Source={x:Reference Page}, Path=Width, Converter={StaticResource HomePageWidthToHomeHeaderSectionHeight}}">
                        <sscxftoolkitpresentationrenderedviews:VideoPlayerView                    
                            AutoPlay="True"
                            Repeat="True"
                            ShowControls="False"
                            Source="{Binding Source={x:Static providers:VideoSourceProvider.HomeVideoSource}}" />
                        <BoxView Color="{StaticResource BrandPrimaryColor}" Opacity="0.5" />
                    </Grid>
                    <Grid
                        BackgroundColor="{StaticResource BrandPrimaryColor}"
                        WidthRequest="{Binding Source={x:Reference AnimationVideoClipContainer}, Path=Width, Mode=OneWay}"
                        HeightRequest="{Binding Source={x:Reference AnimationVideoClipContainer}, Path=Height, Mode=OneWay}">
                        <Image
                            Opacity="0.20"
                            Aspect="AspectFill"
                            Source="{Binding Source={x:Static providers:ImageSourceProvider.Instance}, Path=RandomOfficeImageSource}" />
                        <StackLayout 
                            Margin="10"
                            VerticalOptions="Center" HorizontalOptions="Center">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform Android="app_logo.png" UWP="Assets/Images/AppLogo.png" />
                                </Image.Source>
                            </Image>
                            <Label 
                                HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span 
                                            Text="TuTV" 
                                            TextColor="#c3c3c3"
                                            FontFamily="{StaticResource SouvenirLtBTBoldFontFamily}"
                                            FontSize="Subtitle" />
                                        <Span 
                                            Text="Camagüey"
                                            TextColor="#f2f2f2"
                                            FontFamily="{StaticResource SouvenirLtBTBoldFontFamily}"
                                            FontSize="Subtitle" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Text="{StaticResource ProductConcept}"
                                TextColor="WhiteSmoke"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Bienvenido"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                FontFamily="{StaticResource SouvenirMediumFontFamily}"
                                FontSize="Title" />
                        </StackLayout>
                    </Grid>
                </FlexLayout>
                <StackLayout Padding="8" Spacing="8" Margin="0,16,0,0">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Column="0" Grid.Row="0"
                            Text="&#xfdfa;"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="Medium" />
                        <Label 
                            Grid.Column="1" Grid.Row="0"
                            Text="Cartelera"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            FontFamily="{StaticResource SouvenirMediumFontFamily}"
                            FontSize="Subtitle" />
                        <Button
                            Grid.Column="2" Grid.Row="0"
                            VerticalOptions="Center"
                            Text="Ver más"
                            TextColor="{StaticResource BrandSecoundaryColor}"
                            BackgroundColor="Transparent"
                            Clicked="ViewMoreBillboardButton_Clicked" />
                        <BoxView
                            Grid.ColumnSpan="3" Grid.Row="1"
                            Color="DimGray" />
                    </Grid>
                    <ScrollView Orientation="Horizontal">
                        <FlexLayout
                            BindableLayout.ItemsSource="{Binding Presentations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame 
                                        WidthRequest="320" HeightRequest="180"
                                        Padding="0"
                                        Margin="8">
                                        <Frame.GestureRecognizers>
                                            <ClickGestureRecognizer Clicked="PresentationsItemClickGesture_Recognized" />
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <ffimageloadingforms:CachedImage
                                                Grid.ColumnSpan="2" Grid.RowSpan="2"
                                                Aspect="AspectFill"
                                                Source="{Binding Path=Show.Poster, Converter={StaticResource ImageEntityToImageSource}}" />
                                            <Grid
                                                Grid.Column="0" Grid.Row="0"
                                                Padding="8"
                                                BackgroundColor="{StaticResource BrandPrimaryOpaqueColor}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.ColumnSpan="2" Grid.Row="0"
                                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                                    Text="{Binding Path=At, Converter={StaticResource DateTimeToInvarianCultureRelativeDayString}}"
                                                    TextColor="White"
                                                    HorizontalTextAlignment="Center" />
                                                <renderedviews:FontStrechLabel
                                                    Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtHourFontSize}"
                                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                                    Text="{Binding Path=At, StringFormat='{0:hh}'}"
                                                    TextColor="White">
                                                    <Label.Margin>
                                                        <OnPlatform Android="0,1,0,0" UWP="0,2,0,0" />
                                                    </Label.Margin>
                                                </renderedviews:FontStrechLabel>
                                                <Label
                                                    Grid.Column="1" Grid.Row="1"
                                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                                    FontAttributes="Bold"
                                                    Text="{Binding Path=At, StringFormat='{0:mm}'}"
                                                    TextColor="White"
                                                    VerticalOptions="End" />
                                                <Label
                                                    Grid.Column="1" Grid.Row="2"
                                                    FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=BillboardListViewItemAtOthersFontSize}"
                                                    FontFamily="{StaticResource HelveticaLTStdUltraCompFontFamily}"
                                                    FontAttributes="Bold"
                                                    Text="{Binding Path=At, StringFormat='{0:tt}'}"
                                                    TextColor="White"
                                                    VerticalOptions="Start" />
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ScrollView>
                    <ActivityIndicator IsRunning="True" IsVisible="{Binding Presentations, Converter={StaticResource NullToBoolean}}" />
                    <Label 
                        Margin="8"
                        IsVisible="{Binding Presentations, Converter={StaticResource EnumerableEmptyToBoolean}}"
                        Text="Sin elementos que mostrar"
                        TextColor="DimGray" />
                </StackLayout>
                <StackLayout Padding="8" Spacing="8">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Column="0" Grid.Row="0"
                            Text="&#xf395;"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="Medium" />
                        <Label 
                            Grid.Column="1" Grid.Row="0"
                            Text="Noticias"
                            TextColor="Black"
                            VerticalTextAlignment="Center"
                            FontFamily="{StaticResource SouvenirMediumFontFamily}"
                            FontSize="Subtitle" />
                        <Button
                            Grid.Column="2" Grid.Row="0"
                            VerticalOptions="Center"
                            Text="Ver más"
                            TextColor="{StaticResource BrandSecoundaryColor}"
                            BackgroundColor="Transparent"
                            Clicked="ViewMoreNewsButton_Clicked" />
                        <BoxView
                            Grid.ColumnSpan="3" Grid.Row="1"
                            Color="DimGray" />
                    </Grid>
                    <ScrollView Orientation="Horizontal">
                        <FlexLayout
                            BindableLayout.ItemsSource="{Binding Posts}"
                            BindableLayout.ItemTemplateSelector="{StaticResource PostCardDataTemplateSelector}"/>
                    </ScrollView>
                    <ActivityIndicator IsRunning="True" IsVisible="{Binding Posts, Converter={StaticResource NullToBoolean}}" />
                    <Label 
                        Margin="8"
                        IsVisible="{Binding Posts, Converter={StaticResource EnumerableEmptyToBoolean}}"
                        Text="Sin elementos que mostrar"
                        TextColor="DimGray" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>