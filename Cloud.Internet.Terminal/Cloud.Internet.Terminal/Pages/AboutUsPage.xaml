<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:TabbedPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftollkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.AboutUsPage"
    Title="Televisión Camagüey">
    <TabbedPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="UpdateToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="Material Design Icons" 
                    Glyph="&#xf6ea;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </TabbedPage.ToolbarItems>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Acerca de">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="Material Design Icons" 
                Glyph="&#xf9f0;" />
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <WebView Source="{Binding About}" />
                <sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Historia">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="Material Design Icons" 
                Glyph="&#xfbaf;" />
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <WebView Source="{Binding History}" />
                <sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Contacto">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="Material Design Icons" 
                Glyph="&#xf780;" />
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <ScrollView>
                    <StackLayout Spacing="0">
                        <StackLayout 
                            Margin="15,30,15,10"
                            Spacing="30">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform x:TypeArguments="FileImageSource">
                                        <On Platform="Android" Value="vendor_logo.png" />
                                        <On Platform="UWP" Value="Assets/Images/VendorLogo.png" />
                                        <On Platform="iOS" Value="ContractorLogo" />
                                    </OnPlatform>
                                </Image.Source>
                            </Image>
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceAround">
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1c3;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPhoneNumber}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1ee;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactEmailAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf352;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPostalAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                            </FlexLayout>
                        </StackLayout>
                        <Image VerticalOptions="EndAndExpand" HorizontalOptions="Start">
                            <Image.Source>
                                <OnPlatform x:TypeArguments="FileImageSource">
                                    <On Platform="Android" Value="vendor_tail.png" />
                                    <On Platform="UWP" Value="Assets/Images/VendorTail.png" />
                                    <On Platform="iOS" Value="VendorSignature" />
                                </OnPlatform>
                            </Image.Source>
                        </Image>
                    </StackLayout>
                </ScrollView>
                <sscxftollkitpresentationviews:BusyView />
            </Grid>            
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
</sscxftoolkitmvvmpages:TabbedPage>