<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:TabbedPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftollkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.AboutUsPage"
    Title="Televisión Camagüey">
    <TabbedPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="UpdateToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="Material Design Icons" 
                    Glyph="&#xf6ea;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </TabbedPage.ToolbarItems>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Acerca de">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="IcoMoon" 
                Glyph="&#xe900;" />
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <ScrollView>
                    <StackLayout>
                        <Label
                            Margin="10"
                            Text="{Binding Path=About}"
                            TextColor="Black"
                            TextType="Html"
                            FontSize="16" />
                    </StackLayout>
                </ScrollView>
                <sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Historia">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="Material Design Icons" 
                Glyph="&#xfbaf;" />
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <ScrollView>
                    <StackLayout>
                        <Label
                            Margin="10"
                            Text="{Binding Path=History}"
                            TextColor="Black"
                            TextType="Html"
                            FontSize="16" />
                    </StackLayout>
                </ScrollView><sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Contacto">
        <ContentPage.IconImageSource>
            <FontImageSource 
                FontFamily="Material Design Icons" 
                Glyph="&#xf780;" />
        </ContentPage.IconImageSource>
        <ContentPage.Resources>
            <converters:FlextLayoutToResponsiveItemWidthConverter x:Key="FlextLayoutToResponsiveItemWidth" ItemMinWidth="280" ItemHorizontalMargin="16" />

            <Style x:Key="FlexContactContainer" TargetType="StackLayout">
                <Setter Property="Padding" Value="0,20" />
                <Setter Property="WidthRequest" Value="{Binding Source={x:Reference ResponsiveWrapper}, Path=Width, Converter={StaticResource FlextLayoutToResponsiveItemWidth}}" />
            </Style>
        </ContentPage.Resources>
        <ContentPage.Content>
            <Grid>
                <ScrollView>
                    <StackLayout Spacing="0">
                        <StackLayout 
                            Margin="15,30,15,10"
                            Spacing="30">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform x:TypeArguments="FileImageSource">
                                        <On Platform="Android" Value="vendor_logo.png" />
                                        <On Platform="UWP" Value="Assets/Images/VendorLogo.png" />
                                        <On Platform="iOS" Value="VendorLogo" />
                                    </OnPlatform>
                                </Image.Source>
                            </Image>
                            <FlexLayout
                                x:Name="ResponsiveWrapper"
                                Wrap="Wrap"
                                JustifyContent="SpaceAround">
                                <StackLayout Style="{StaticResource FlexContactContainer}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1c3;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPhoneNumber}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Padding="16,0"
                                        BackgroundColor="{StaticResource BrandSecoundaryColor}"
                                        Text="Llamar"
                                        TextColor="White"
                                        Clicked="VendorPhoneButton_Clicked" />
                                </StackLayout>
                                <StackLayout Style="{StaticResource FlexContactContainer}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1ee;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactEmailAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Padding="16,0"
                                        BackgroundColor="{StaticResource BrandSecoundaryColor}"
                                        Text="Escribir"
                                        TextColor="White"
                                        Clicked="VendorEmailButton_Clicked" />
                                </StackLayout>
                                <StackLayout Style="{StaticResource FlexContactContainer}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf352;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPostalAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                    <Button
                                        HorizontalOptions="Center"
                                        Padding="16,0"
                                        BackgroundColor="{StaticResource BrandSecoundaryColor}"
                                        Text="Ubicar"
                                        TextColor="White"
                                        Clicked="VendorMapButton_Clicked" />
                                </StackLayout>
                            </FlexLayout>
                        </StackLayout>
                        <Image
                            Margin="0,30,0,0"
                            VerticalOptions="EndAndExpand" HorizontalOptions="Start">
                            <Image.Source>
                                <OnPlatform x:TypeArguments="FileImageSource">
                                    <On Platform="Android" Value="vendor_tail.png" />
                                    <On Platform="UWP" Value="Assets/Images/VendorTail.png" />
                                    <On Platform="iOS" Value="VendorTail" />
                                </OnPlatform>
                            </Image.Source>
                        </Image>
                    </StackLayout>
                </ScrollView>
                <sscxftollkitpresentationviews:BusyView />
            </Grid>            
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
</sscxftoolkitmvvmpages:TabbedPage>