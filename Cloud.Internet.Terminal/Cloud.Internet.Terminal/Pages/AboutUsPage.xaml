<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:TabbedPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Helpers"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftollkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.AboutUsPage"
    Title="Televisión Camagüey">
    <TabbedPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="UpdateToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </TabbedPage.ToolbarItems>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Acerca de">
        <ContentPage.IconImageSource>
            <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xf9f0;">
                <FontImageSource.Color>
                    <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                </FontImageSource.Color>
            </FontImageSource>
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <WebView Source="{Binding About}" />
                <sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Historia">
        <ContentPage.IconImageSource>
            <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xfbaf;">
                <FontImageSource.Color>
                    <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                </FontImageSource.Color>
            </FontImageSource>
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <WebView Source="{Binding History}" />
                <sscxftollkitpresentationviews:BusyView />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage
        Title="Contacto">
        <ContentPage.IconImageSource>
            <FontImageSource 
                    FontFamily="{StaticResource IconFontFamily}" 
                    Glyph="&#xf780;">
                <FontImageSource.Color>
                    <OnPlatform x:DataType="Color" UWP="Black" Android="White" iOS="Black" />
                </FontImageSource.Color>
            </FontImageSource>
        </ContentPage.IconImageSource>
        <ContentPage.Content>
            <Grid>
                <ScrollView>
                    <StackLayout Spacing="0">
                        <StackLayout 
                            Margin="15,30,15,10"
                            Spacing="30">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform Android="vendor_logo.png" UWP="Assets/Images/VendorLogo.png" />
                                </Image.Source>
                            </Image>
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceAround">
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1c3;"
                                        TextColor="Black"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPhoneNumber}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf1ee;"
                                        TextColor="Black"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactEmailAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                                <StackLayout WidthRequest="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=FluidContainerWidth}">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="&#xf352;"
                                        TextColor="Black"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="{Binding Source={x:Static helpers:ConstantProvisionHelper.Instance}, Path=OverviewProfileImageSize}" />
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding ContactPostalAddress}"
                                        TextColor="Black" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="Puede contactanos vía telefónica en el horario de 9:00 am a 4:30 pm de lunes a viernes. Le atenderemos con gusto."
                                        TextColor="DimGray" />
                                </StackLayout>
                            </FlexLayout>
                        </StackLayout>
                        <Image VerticalOptions="EndAndExpand" HorizontalOptions="Start">
                            <Image.Source>
                                <OnPlatform Android="vendor_tail.png" UWP="Assets/Images/VendorTail.png" />
                            </Image.Source>
                        </Image>
                    </StackLayout>
                </ScrollView>
                <sscxftollkitpresentationviews:BusyView />
            </Grid>            
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
</sscxftoolkitmvvmpages:TabbedPage>