<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.TVCamaguey.Cloud.Internet.Terminal.Pages.SupportPage"
    Title="Información y Ayuda">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="CornflowerBlue" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <StackLayout Spacing="0">
                    <Grid
                        BackgroundColor="{StaticResource BrandPrimaryColor}">
                        <StackLayout 
                            Margin="10,50"
                            VerticalOptions="Center" HorizontalOptions="Center">
                            <Image HorizontalOptions="Center">
                                <Image.Source>
                                    <OnPlatform x:TypeArguments="FileImageSource">
                                        <On Platform="Android" Value="app_logo.png" />
                                        <On Platform="UWP" Value="Assets/Images/AppLogo.png" />
                                        <On Platform="iOS" Value="AppLogoSmall" />
                                    </OnPlatform>
                                </Image.Source>
                            </Image>
                            <Label 
                                HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span 
                                            Text="TuTV" 
                                            TextColor="#c3c3c3"
                                            FontFamily="Souvenir Lt BT Bold"
                                            FontSize="Subtitle" />
                                        <Span 
                                            Text="Camagüey"
                                            TextColor="#f2f2f2"
                                            FontFamily="Souvenir Lt BT Bold"
                                            FontSize="Subtitle" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label 
                                HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span 
                                            Text="Versión: " 
                                            TextColor="White"
                                            FontAttributes="Bold"/>
                                        <Span 
                                            Text="0.1.0-beta"
                                            TextColor="White" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </Grid>
                    <StackLayout Padding="20,8,20,20">
                        <Label FontFamily="Helvetica LT Std Bold Condensed" Padding="0,20,0,0" TextColor="Black" HorizontalTextAlignment="Center" Text="Acerca de:" />
                        <Label TextColor="Black" Text="Esta aplicación permite a Televisión Camagüey divulgar la información relacionada con la cartelera, programas y noticias, así como información de la institución, sus trabajadores y datos de contacto." />
                        <Label FontFamily="Helvetica LT Std Bold Condensed" Padding="0,20,0,0" TextColor="Black" HorizontalTextAlignment="Center" Text="Sobre esta versión de prueba:" />
                        <Label TextColor="Black" Text="Esta versión ha sido creada con el objetivo de realizar pruebas iniciales de funcionamiento por múltiples usuarios del sistema. Es una versión en estado de desarrollo, por lo que puede ser inestable en algún momento, contener pequeños errores, elementos incompletos, además de no contar con un diseño completamente refinado." />
                        <Label TextColor="Black" Text="Recomendamos a los usuarios que prueban esta versión, que continúen atentos a nuevas actualizaciones de la aplicación mediante los distintos medios informativos que tienen a su alcance, tanto de Televisión Camagüey como de los desarrolladores de la aplicación." />
                        <Label TextColor="Black" Text="Si tienes cualquier pregunta, comentario o sugerencia que quieras realizarnos, ideas que desees compartir con nosotros, ¡estaremos siempre complacidos de escucharte!" />
                        <Label TextColor="Black" Text="Puedes contactarnos por las siguientes vías:" />
                        <Image Margin="0,40,0,0">
                            <Image.Source>
                                <FileImageSource>
                                    <FileImageSource.File>
                                        <OnPlatform x:TypeArguments="x:String">
                                            <On Platform="iOS" Value="VendorLogo" />
                                            <On Platform="Android" Value="vendor_logo" />
                                        </OnPlatform>
                                    </FileImageSource.File>
                                </FileImageSource>
                            </Image.Source>
                        </Image>
                        <FlexLayout
                            Margin="8,8,8,0"
                            Wrap="Wrap"
                            AlignContent="Stretch"
                            JustifyContent="SpaceAround">
                            <Button
                                Text="Sitio Web"
                                ContentLayout="Top,10"
                                Clicked="VendorWebSiteButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Color="CornflowerBlue">
                                        <FontImageSource.Glyph>
                                            <OnPlatform x:TypeArguments="x:String">
                                                <On Platform="Android" Value="&#xf2af;" />
                                                <On Platform="iOS" Value="&#xf039;" />
                                                <On Platform="UWP" Value="&#xf1e9;" />
                                            </OnPlatform>
                                        </FontImageSource.Glyph>
                                    </FontImageSource>
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Teléfono"
                                ContentLayout="Top,10"
                                Clicked="VendorPhoneButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf1c3;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Email"
                                ContentLayout="Top,10"
                                Clicked="VendorEmailButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf1ee;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Mapa"
                                ContentLayout="Top,10"
                                Clicked="VendorMapButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf352;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Facebook"
                                ContentLayout="Top,10"
                                Clicked="VendorFacebookButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf20d;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Twitter"
                                ContentLayout="Top,10"
                                Clicked="VendorTwitterButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf544;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Instagram"
                                ContentLayout="Top,10"
                                Clicked="VendorInstagramButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf2fe;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Youtube"
                                ContentLayout="Top,10"
                                Clicked="VendorYoutubeButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf5c3;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                        </FlexLayout>
                        <Image Margin="0,20,0,0">
                            <Image.Source>
                                <FileImageSource>
                                    <FileImageSource.File>
                                        <OnPlatform x:TypeArguments="x:String">
                                            <On Platform="iOS" Value="OwnerLogo" />
                                            <On Platform="Android" Value="owner_logo" />
                                        </OnPlatform>
                                    </FileImageSource.File>
                                </FileImageSource>
                            </Image.Source>
                        </Image>
                        <FlexLayout
                            Margin="8,8,8,0"
                            Wrap="Wrap"
                            AlignContent="Stretch"
                            JustifyContent="SpaceAround">
                            <Button
                                Text="Sitio Web"
                                ContentLayout="Top,10"
                                Clicked="OwnerWebSiteButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Color="CornflowerBlue">
                                        <FontImageSource.Glyph>
                                            <OnPlatform x:TypeArguments="x:String">
                                                <On Platform="Android" Value="&#xf2af;" />
                                                <On Platform="iOS" Value="&#xf039;" />
                                                <On Platform="UWP" Value="&#xf1e9;" />
                                            </OnPlatform>
                                        </FontImageSource.Glyph>
                                    </FontImageSource>
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Teléfono"
                                ContentLayout="Top,10"
                                Clicked="OwnerPhoneButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf1c3;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Email"
                                ContentLayout="Top,10"
                                Clicked="OwnerEmailButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf1ee;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Facebook"
                                ContentLayout="Top,10"
                                Clicked="OwnerFacebookButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf20d;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Telegram"
                                ContentLayout="Top,10"
                                Clicked="OwnerTelegramButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf501;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                            <Button
                                Text="Twitter"
                                ContentLayout="Top,10"
                                Clicked="OwnerTwitterButton_Clicked">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="Material Design Icons" 
                                        Glyph="&#xf544;"
                                        Color="CornflowerBlue" />
                                </Button.ImageSource>
                            </Button>
                        </FlexLayout>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <sscxftoolkitpresentationviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>