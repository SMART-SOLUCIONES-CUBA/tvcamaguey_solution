{
  "PerformanceRegulation": {
    "IterationDesiredElapseTime": "00:00:30",
    "IterationRequestCount": 10
  },
/*
  SMTP > Security  
  ===============      
  None => 0 (No SSL or TLS encryption should be used.)
  Auto => 1 (Allow the MailKit.IMailService to decide which SSL or TLS options to use (default). If the server does not support SSL or TLS, then the connection will continue without any encryption.)
  SslOnConnect => (The connection should use SSL or TLS encryption immediately.)
  StartTls => 3 (Elevates the connection to use TLS encryption immediately after reading the greeting and capabilities of the server. If the server does not support the STARTTLS extension, then the connection will fail and a System.NotSupportedException will be thrown.)
  StartTlsWhenAvailable => 4 (Elevates the connection to use TLS encryption immediately after reading the greeting and capabilities of the server, but only if the server supports the STARTTLS extension.)
*/
  "Smtp": {
    "Host": "correo.icrt.cu",
    "Port": 465,
    "Security": 1,
    "User": "carlos.leon@icrt.cu",
    "Password": "Solrac901124*",
    "SubjectTemplate": "HOla!",
    "BodyTemplate": "{0}: {1}"
  },
  "Serilog": {
    "MinimumLevel": "Error",
    "WriteTo": [
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "logs\\{Date}.log"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
