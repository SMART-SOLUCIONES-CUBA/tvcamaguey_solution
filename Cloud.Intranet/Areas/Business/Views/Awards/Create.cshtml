@model SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.AwardInputViewModel

@{
    ViewData["Title"] = "Agregar " + GlobalViewLocalizationHelper.Localize("Award", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = GlobalViewLocalizationHelper.Localize("Awards", ViewLocalizer),
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("create", "awards", new { Area = "business" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4>@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Edition, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Edition, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Edition, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.IsInstitutional) @Html.DisplayNameFor(model => model.IsInstitutional)
                        </label>
                    </div>
                </div>
            </div>
            
            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Crear</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}