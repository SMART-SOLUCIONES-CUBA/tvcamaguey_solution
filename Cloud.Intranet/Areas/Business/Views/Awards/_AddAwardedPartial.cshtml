@model SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.AwardEmployBridgeInputViewModel

<div class="modal fade" id="add-awarded" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="add-awarded-title">Agregar Galardonado</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("addawarded", "awards", null, FormMethod.Post, true, null))
            {
            <div class="modal-body">
                @Html.HiddenFor(model => model.AwardId)

                <div style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.EmployId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.EmployId, Model.AvailableEmploys, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.EmployId, null, new { @class = "text-danger" })
                </div>
            </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Agregar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
