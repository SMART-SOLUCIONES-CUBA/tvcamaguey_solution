@model SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.AwardAwardedsManageViewModel

@{
    ViewData["Title"] = "Modificar " + GlobalViewLocalizationHelper.Localize("Award", ViewLocalizer) + " (" + GlobalViewLocalizationHelper.Localize("Awardeds", ViewLocalizer) + ")";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = GlobalViewLocalizationHelper.Localize("Awards", ViewLocalizer),
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="card bg-light" style="margin-bottom: 20px;">
    <div class="card-body">
        <h5 class="card-title">Datos del Galardón</h5>
        <dl>
            <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("Title", ViewLocalizer)</dt>
            <dd>@Model.Award.Title</dd>
            <dt class="text-secondary">@GlobalViewLocalizationHelper.Localize("Edition", ViewLocalizer)</dt>
            <dd>@Model.Award.Edition</dd>
        </dl>
    </div>
</div>

<div class="page-header">
    <h3>@GlobalViewLocalizationHelper.Localize("Awardeds", ViewLocalizer)<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-awarded">Agregar Autor</a></h3>
</div>

@await Html.PartialAsync("_AddAwardedPartial", new SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.AwardEmployBridgeInputViewModel
{
    AwardId = Model.Award.Id,
    AvailableEmploys = Model.AvailableEmploys
})

<div style="border: 1px solid #DDD; border-radius: 4px; margin-bottom: 20px;">
    <table class="table" style="margin: 0;">
        <thead>
            <tr>
                <th>@GlobalViewLocalizationHelper.Localize("Name")</th>
                <th>@GlobalViewLocalizationHelper.Localize("LastName")</th>
                <th style="width: 1px; white-space: nowrap;">Opciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Awardeds.Count > 0)
            {
                @foreach (var item in Model.Awardeds)
                {
                    <tr>
                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Name")">@item.Name</td>
                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("LastName")">@item.LastName</td>
                        <td style="vertical-align: middle;">
                            <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-awarded-@Model.Award.Id-@item.Id"><span class="fas fa-trash"></span> Eliminar</a>

                            @await Html.PartialAsync("_DeleteAwardedPartial", new SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.AwardEmployBridgeDisplayViewModel { AwardId = Model.Award.Id, Award = Model.Award, EmployId = item.Id, Employ = item })
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            }
        </tbody>
    </table>
</div>


