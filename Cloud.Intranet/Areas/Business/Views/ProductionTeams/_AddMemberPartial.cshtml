@model SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.ProductionTeamEmployBridgeInputViewModel

@{ 
    var availableProductionRoleSelectionListItems = new List<SelectListItem>();

    var productionTeamEnumValues = System.Enum.GetValues(typeof(SmartSolucionesCuba.TVCamaguey.Cloud.Persistence.Enumerations.ProductionRole));
    var productionTeamEnumNames = System.Enum.GetNames(typeof(SmartSolucionesCuba.TVCamaguey.Cloud.Persistence.Enumerations.ProductionRole));

    for (int i = 0; i < productionTeamEnumValues.Length; i++)
    {
        availableProductionRoleSelectionListItems.Add(new SelectListItem(productionTeamEnumValues.GetValue(i).ToString(), GlobalViewLocalizationHelper.Localize(productionTeamEnumNames[i], ViewLocalizer)));
    }
}

<div class="modal fade" id="add-member" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="add-member-title">Agregar @GlobalViewLocalizationHelper.Localize("Member", ViewLocalizer)</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("addmember", "productionteams", null, FormMethod.Post, true, null))
            {
                <div class="modal-body">
                    @Html.HiddenFor(model => model.ProductionTeamId)

                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.EmployId, new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.EmployId, Model.AvailableEmploys, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.EmployId, null, new { @class = "text-danger" })
                    </div>

                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.ProductionRole, new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.ProductionRole, availableProductionRoleSelectionListItems, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ProductionRole, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Agregar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
