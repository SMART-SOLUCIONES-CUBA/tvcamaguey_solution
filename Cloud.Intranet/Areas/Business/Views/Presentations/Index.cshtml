@model SmartSolucionesCuba.SAPRESSC.Core.Web.Frontend.Models.View.PaginationViewModel<SmartSolucionesCuba.TVCamaguey.Cloud.Persistence.Entities.Presentation, System.Guid, SmartSolucionesCuba.TVCamaguey.Cloud.Intranet.Models.View.PresentationDisplayViewModel>

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Presentations", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
{
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="row" style="margin-bottom: 20px;">
    <div class="col-sm-4"></div>
    <div class="col-sm-4" style="text-align: center;">
        <div class="btn-group">
            <a class="btn btn-light" href="@Url.Action("billboard")"><span class="fas fa-calendar"></span> Cartelera</a>
            <button class="btn btn-primary" style="cursor:default;"><span class="fas fa-list-alt"></span> Listado</button>
        </div>
    </div>
    <div class="col-sm-4" style="text-align: right;"><a class="btn btn-primary pull-right" href="@Url.Action("create")">Agregar</a></div>
</div>

<div class="clearfix" style="margin-bottom: 20px;"></div>

@if (Model.MaxPageCount > 0)
{
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination justify-content-center" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a class="page-link" href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a class="page-link" href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-muted" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }

    <div style="border: 1px solid #DDD; border-radius: 4px; margin-bottom: 20px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>@GlobalViewLocalizationHelper.Localize("Show", ViewLocalizer)</th>
                    <th>@GlobalViewLocalizationHelper.Localize("ProductionTeam", ViewLocalizer)</th>
                    <th>@GlobalViewLocalizationHelper.Localize("DateTime", ViewLocalizer)</th>
                    <th style="width: 1px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Name", ViewLocalizer)">@item.ShowName</td>
                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("ProductionTeam", ViewLocalizer)">@item.ProductionTeamName</td>
                        <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("DateTime", ViewLocalizer)">@item.At</td>
                        <td style="vertical-align: middle;">
                            <div class="btn-group btn-group-sm">
                                <a role="button" href="@Url.Action("edit", new { key = item.Id })" class="btn btn-light" title="Editar"><span class="fas fa-edit"></span><span class="hidden-xs"> Modificar</span></a>
                                <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="fas fa-trash"></span> Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination justify-content-center" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a class="page-link" href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="page-item active"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a class="page-link" href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-muted" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }
}
else
{
    <div style="border: 1px solid #DDD; border-radius: 4px; margin-bottom: 20px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>@GlobalViewLocalizationHelper.Localize("Show", ViewLocalizer)</th>
                    <th>@GlobalViewLocalizationHelper.Localize("ProductionTeam", ViewLocalizer)</th>
                    <th>@GlobalViewLocalizationHelper.Localize("DateTime", ViewLocalizer)</th>
                    <th style="width: 1px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            </tbody>
        </table>
    </div>
}

