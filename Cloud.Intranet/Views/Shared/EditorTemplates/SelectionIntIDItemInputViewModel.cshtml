@model SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View.SelectionItemInputViewModel<int>

<div class="col-md-6">
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Label)
    
    <div class="checkbox">
        <label>
            @Html.CheckBoxFor(model => model.Selected)
            @GlobalViewLocalizationHelper.Localize(Model.Label, ViewLocalizer)
        </label>
    </div>
</div>
